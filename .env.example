# WMS AI Assistant - Environment Variables (Phase 3.1)
# Copy to .env and fill in real values. .env is gitignored.

# ===== Application =====
APP_NAME=WMS AI Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== LLM (OpenAI-compatible) =====
# LLM_PROVIDER: human-readable identifier (openai, deepseek, qwen, ollama, ...).
# Used for logging / display only; does NOT affect protocol.
LLM_PROVIDER=

# LLM_MODEL: model name sent in the request body.
LLM_MODEL=

# LLM_API_KEY: required to call real LLM. Leave empty to use MockLLMClient.
# NEVER commit real keys to Git.
LLM_API_KEY=

# LLM_BASE_URL: chat completions endpoint base.
# Trailing /v1 is optional for some (auto-redirected); recommended for clarity.
# Examples (all work):
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1   (or https://api.deepseek.com — auto-redirected)
#   Qwen:        https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:      http://localhost:11434/v1
#   SiliconFlow: https://api.siliconflow.cn/v1
# NOTE: After setting LLM_BASE_URL, NEVER commit real keys to Git.
LLM_BASE_URL=

# LLM_TIMEOUT_*: httpx timeout (seconds) for each phase of the request.
LLM_TIMEOUT_CONNECT=10
LLM_TIMEOUT_READ=60
LLM_TIMEOUT_WRITE=10
LLM_TIMEOUT_POOL=10

# ===== Database (Phase 3.1: PostgreSQL + pgvector) =====
# DATABASE_URL: SQLAlchemy URL with psycopg 3 driver.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Leave empty to disable all DB features (health returns database="disabled",
# /api/chat still works, /api/knowledge endpoints — added in Phase 3.2 — won't).
# DO NOT commit real passwords. Use environment variables / Docker secrets in prod.
#
# Example (local dev via docker-compose):
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wms_ai
DATABASE_URL=

# DATABASE_ECHO: set to 1/true/yes/on to log all SQL statements (development only).
DATABASE_ECHO=false

# DATABASE_POOL_SIZE: SQLAlchemy connection pool base size.
DATABASE_POOL_SIZE=5

# DATABASE_MAX_OVERFLOW: extra connections beyond pool_size under load.
DATABASE_MAX_OVERFLOW=10

# ===== WMS/ERP business database (independent READ-ONLY datasource) =====
# The inventory tool (get_inventory) reads the CUSTOMER WMS/ERP database.
# It is a SEPARATE datasource from the application database above:
#   * DATABASE_URL        -> application data (ai_ops / knowledge / conversations)
#   * WMS_DATABASE_*      -> WMS/ERP business data (read-only account)
# No shared engine / no connection reuse. When any of these is missing the
# inventory tool FAILS EXPLICITLY -- it NEVER falls back to DATABASE_URL and
# never fabricates data. No tables are created and no migrations are run.
# Use a READ-ONLY account. NEVER commit real credentials; keep them in the
# local gitignored .env (see .gitignore: .env / .env.*).
WMS_DATABASE_HOST=
WMS_DATABASE_PORT=5432
WMS_DATABASE_NAME=
WMS_DATABASE_USER=
WMS_DATABASE_PASSWORD=
# Independent (small) pool for the read-only tool + connect timeout (seconds).
WMS_DATABASE_POOL_SIZE=2
WMS_DATABASE_MAX_OVERFLOW=1
WMS_DATABASE_CONNECT_TIMEOUT=5

# Inventory stock-on-hand query (Phase 7 report integration).
# The tool implements the WMS report "库存现存量报表" (barcode-based on-hand
# stock): table/column mapping is a FIXED server-side constant list
# (dyn_wh_barcode + status dict / warehouse / location / shelf / batch /
#  material / unit / org / location-record); ONLY the schema is configurable
# and it is identifier-validated (never taken from user input).
WMS_INVENTORY_SCHEMA=public

# Max grouped rows returned (LIMIT; default 100, clamped to [1, 500]).
WMS_INVENTORY_MAX_ROWS=100

# PostgreSQL statement_timeout for the read-only query (seconds; default 10).
WMS_INVENTORY_QUERY_TIMEOUT_SECONDS=10

# ===== Embedding (Phase 3.5.1: OpenAI-compatible embeddings) =====
# DeepSeek 官方 API 不提供 Embedding 端点，因此 Embedding 走通用
# OpenAI 兼容协议（POST {base_url}/embeddings），可对接以下任一服务：
#   OpenAI:      https://api.openai.com/v1        (text-embedding-3-small: 1536 维)
#   硅基流动:     https://api.siliconflow.cn/v1     (BAAI/bge-* 系列)
#   Qwen:        https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:      http://localhost:11434/v1
#
# EMBEDDING_PROVIDER: human-readable identifier (logging/display only).
EMBEDDING_PROVIDER=

# EMBEDDING_MODEL: model name sent in the request body. Set explicitly — do not guess.
EMBEDDING_MODEL=

# EMBEDDING_BASE_URL: embeddings endpoint base (must serve POST /embeddings).
EMBEDDING_BASE_URL=

# EMBEDDING_API_KEY: leave empty to fall back to LLM_API_KEY (when both APIs share one key).
# NEVER commit real keys to Git.
EMBEDDING_API_KEY=

# EMBEDDING_DIMENSION: expected vector length. Must match knowledge_chunk.embedding vector(N).
# Default 1024 = BAAI/bge-m3 (SiliconFlow, verified in Phase 3.5.1.5). Client validates strictly (no padding/truncation).
EMBEDDING_DIMENSION=1024

# EMBEDDING_TIMEOUT: request timeout in seconds.
EMBEDDING_TIMEOUT=60

# ===== Reranker (Phase 3.5.12 offline; Phase 3.7.14 wired into RAG) =====
# RERANKER_ENABLED: master switch, default false. When true, RagService inserts
# a rerank stage BETWEEN vector search and context builder:
#   Vector Search (RERANKER_CANDIDATE_TOP_K) -> Reranker -> top RERANKER_TOP_K.
# Also gates the offline reranker experiment tests (RUN_REAL_RERANKER=1) and
# the real Reranker E2E (RUN_REAL_RAG_E2E=1 RUN_DB_TESTS=1 RERANKER_ENABLED=true).
RERANKER_ENABLED=false

# RERANKER_MODEL: HuggingFace model name (local Cross-Encoder).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# RERANKER_DEVICE: inference device. Empty = auto (cuda if available, else cpu).
# Explicit values allowed: cuda / cpu.
RERANKER_DEVICE=

# RERANKER_MAX_LENGTH: tokenizer max_length for (query, doc) pairs.
RERANKER_MAX_LENGTH=512

# RERANKER_BATCH_SIZE: number of (query, doc) pairs per forward pass.
# Default 8. Allowed: 1, 2, 4, 8, 16. Batch is internal — the public API
# (rerank(query, documents)) still takes the full document list.
# Larger batch reduces per-doc ms but increases peak memory.
RERANKER_BATCH_SIZE=8

# RERANKER_CANDIDATE_TOP_K (Phase 3.7.14): recall size fed to the reranker
# when enabled. Default 10, clamped to [1, 50].
RERANKER_CANDIDATE_TOP_K=10

# RERANKER_TOP_K (Phase 3.7.14): final chunk count after rerank (sent to the
# context builder) when enabled and caller does not pass top_k explicitly.
# Default 3, clamped to [1, 50].
RERANKER_TOP_K=3

# ===== Project (Phase 3.7.1.1: non-sensitive project identity) =====
# Used by backend/app/projects (ProjectContext / DataSource abstraction).
# These are display-level metadata ONLY -- connection credentials stay in
# DATABASE_URL above and are NEVER copied into ProjectContext.
#
# PROJECT_ID is ALSO the server-side PROJECT SCOPE for this deployment
# (Phase 7 Recovery M2.2 D1): POST /api/conversations only accepts a
# client-supplied project_id that exactly equals this value. Changing
# PROJECT_ID changes which project this deployment allows sessions to be
# created in. Being listed in the server-side Project Registry is NOT
# sufficient (registered != authorized); a project that is registered but
# differs from this value is rejected (422).
#
# Keep this value consistent with the Project Registry entry the deployment
# resolves (see docs/api.md §12 and docs/security.md §8). If the value is
# missing/blank/unresolvable the creation endpoint fails closed (503) --
# there is NO default-project fallback.
PROJECT_ID=vietnam-wms
PROJECT_NAME=Vietnam WMS
PROJECT_DESCRIPTION=

# ===== Workflow Read API auth (Phase 6 Step 7.2) =====
# GET /api/workflow-runs* and GET /api/workflow-approvals/{id} require the
# X-API-Key header. Both variables MUST be set or those endpoints fail closed
# (503) -- there is NO anonymous fallback and NO default project fallback.
# The authorized project scope comes ONLY from WORKFLOW_READ_API_PROJECT_ID
# (client-supplied project_id query parameters are ignored, NOT trusted).
# NEVER commit a real key here or in any tracked file; the value below is a
# placeholder. Rotate the key via your deployment secret store.
WORKFLOW_READ_API_KEY=
WORKFLOW_READ_API_PROJECT_ID=

# ===== Agent Read API auth (Phase 6 Step 8A) =====
# GET /api/agent/runs/{run_id} and /timeline require the X-API-Key header.
# Same fail-closed rules as above: both variables MUST be set or those
# endpoints return 503 (no anonymous fallback, no default-project fallback).
# Credentials are INDEPENDENT from the Workflow read credentials (separate
# rotation); a deployment MAY set them to the same value -- that is a
# deployment decision, not a code coupling.
# NEVER commit a real key here or in any tracked file.
AGENT_READ_API_KEY=
AGENT_READ_API_PROJECT_ID=

# ===== Workflow Command API auth (Phase 7 Step 1) =====
# POST /api/workflow-runs (start) + /{run_id}/advance|cancel +
# POST /api/workflow-approvals/{approval_id}/decision require X-API-Key.
# Write face (least privilege): credentials are INDEPENDENT from the read
# faces (WORKFLOW_READ_* / AGENT_READ_*) and can be rotated separately.
# Both variables MUST be set or those endpoints return 503 (fail closed;
# no anonymous fallback, no default-project fallback). The authorized
# project scope comes ONLY from WORKFLOW_COMMAND_API_PROJECT_ID.
# NEVER commit a real key here or in any tracked file.
WORKFLOW_COMMAND_API_KEY=
WORKFLOW_COMMAND_API_PROJECT_ID=
# ===== User authentication (Phase 7 Recovery M1) =====
# Human user login (POST /api/auth/login) issues a server-side session and
# sets an HttpOnly cookie. This is SEPARATE from the X-API-Key service
# credentials above (they coexist; neither replaces the other).
# NO public registration endpoint: users are created by an administrator via
#   python -m backend.app.cli.create_user --username <name>
# (password is read from WMS_NEW_USER_PASSWORD or an interactive prompt;
#  never passed via command line).
#
# AUTH_SESSION_COOKIE_NAME  session cookie name (HttpOnly; default wms_ai_session)
# AUTH_CSRF_COOKIE_NAME     CSRF double-submit cookie (NOT HttpOnly; default wms_ai_csrf)
# AUTH_CSRF_HEADER_NAME     CSRF header name (default X-CSRF-Token)
# AUTH_SESSION_TTL_HOURS    absolute session TTL in hours (default 12; [1, 720])
# AUTH_COOKIE_SECURE        Secure flag for auth cookies (default true).
#                           Set to 0 ONLY for plain-HTTP intranet dev access;
#                           production MUST keep true behind TLS.
# AUTH_COOKIE_SAMESITE      SameSite (default lax; none implies Secure)
# AUTH_MAX_FAILED_LOGINS    consecutive failures before lockout (default 5; [1, 20])
# AUTH_LOCKOUT_MINUTES      lockout duration in minutes (default 15; [1, 1440])
AUTH_SESSION_COOKIE_NAME=wms_ai_session
AUTH_CSRF_COOKIE_NAME=wms_ai_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# ===== Observability / Usage Read API ops authorization (Phase 7 Recovery M2.3 A2) =====
# Comma-separated allowlist of M1 user_ids authorized for the GLOBAL read-only
# observability endpoints (they expose cross-project data, so they are NOT
# available to every authenticated user):
#   GET /api/usage/analytics
#   GET /api/observability/tools
#   GET /api/observability/tools/metrics
#   GET /api/observability/assistant-trace/{assistant_request_id}
#   GET /api/observability/assistant-timeline/{assistant_request_id}
#
# The OTHER two read-only endpoints (GET /api/observability/tools/history and
# GET /api/observability/tools/metrics/persistent) are scoped by the server-side
# PROJECT_ID above instead of this allowlist.
#
# Rules:
#   * Match key = the server-issued Principal.user_id (uuid4). Client-supplied
#     roles / admin flags / user-id claims are NEVER accepted.
#   * MUST be set (no default). Empty / blank / containing empty entries
#     (e.g. "a,,b" or a trailing comma) => the ops endpoints fail closed with
#     503. There is NO anonymous fallback and NO "every logged-in user" fallback.
#   * An authenticated user NOT in this list gets 403.
#   * NEVER commit real values here; keep them in the local gitignored .env.
#
# Phase 7 Recovery M2.4 (minimal RBAC) — TRANSITIONAL UNION:
#   The five global observability endpoints above are now authorized by
#   EITHER a legacy whitelist entry OR an explicit SYSTEM_OPS grant row:
#
#       ai_ops.authorization_grant (scope_type='SYSTEM', role='SYSTEM_OPS')
#
#   * This variable stays REQUIRED until it is explicitly deprecated: if it is
#     unusable, those endpoints still return 503 (fail closed) — the union does
#     NOT weaken that.
#   * No new environment variable is introduced by M2.4; grants are DATA.
#   * Grants are written only by the controlled admin CLI (there is no public
#     authorization endpoint and no auto-grant for existing users):
#
#       python -m backend.app.cli.grant_role --user-id <uuid> --role SYSTEM_OPS
#       python -m backend.app.cli.grant_role --user-id <uuid> \
#           --project <project_id> --role MEMBER|PROJECT_OPS
#
#   * The other two read-only endpoints (GET /api/observability/tools/history
#     and GET /api/observability/tools/metrics/persistent) require a PROJECT
#     membership (MEMBER or PROJECT_OPS) for the server-side PROJECT_ID above;
#     the legacy whitelist never grants project access.
OBSERVABILITY_READ_OPS_USER_IDS=
