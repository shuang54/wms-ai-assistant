# =====================================================
# Application
# =====================================================
APP_NAME=WMS AI Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# =====================================================
# LLM（Phase 2 才会真正使用，当前留空即可）
# =====================================================
# 可选值示例：openai / openai_compatible / qwen / deepseek / ollama
LLM_PROVIDER=
# 例如：gpt-4o-mini / qwen-plus / deepseek-chat
LLM_MODEL=
# 严禁提交真实 API Key，仅在此处本地填写
LLM_API_KEY=
# 例如：https://api.openai.com/v1
LLM_BASE_URL=
