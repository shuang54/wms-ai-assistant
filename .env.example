# WMS AI Assistant - Environment Variables (Phase 3.1)
# Copy to .env and fill in real values. .env is gitignored.

# ===== Application =====
APP_NAME=WMS AI Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== LLM (OpenAI-compatible) =====
# LLM_PROVIDER: human-readable identifier (openai, deepseek, qwen, ollama, ...).
# Used for logging / display only; does NOT affect protocol.
LLM_PROVIDER=

# LLM_MODEL: model name sent in the request body.
LLM_MODEL=

# LLM_API_KEY: required to call real LLM. Leave empty to use MockLLMClient.
# NEVER commit real keys to Git.
LLM_API_KEY=

# LLM_BASE_URL: chat completions endpoint base.
# Trailing /v1 is optional for some (auto-redirected); recommended for clarity.
# Examples (all work):
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1   (or https://api.deepseek.com — auto-redirected)
#   Qwen:        https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:      http://localhost:11434/v1
#   SiliconFlow: https://api.siliconflow.cn/v1
# NOTE: After setting LLM_BASE_URL, NEVER commit real keys to Git.
LLM_BASE_URL=

# LLM_TIMEOUT_*: httpx timeout (seconds) for each phase of the request.
LLM_TIMEOUT_CONNECT=10
LLM_TIMEOUT_READ=60
LLM_TIMEOUT_WRITE=10
LLM_TIMEOUT_POOL=10

# ===== Database (Phase 3.1: PostgreSQL + pgvector) =====
# DATABASE_URL: SQLAlchemy URL with psycopg 3 driver.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Leave empty to disable all DB features (health returns database="disabled",
# /api/chat still works, /api/knowledge endpoints — added in Phase 3.2 — won't).
# DO NOT commit real passwords. Use environment variables / Docker secrets in prod.
#
# Example (local dev via docker-compose):
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wms_ai
DATABASE_URL=

# DATABASE_ECHO: set to 1/true/yes/on to log all SQL statements (development only).
DATABASE_ECHO=false

# DATABASE_POOL_SIZE: SQLAlchemy connection pool base size.
DATABASE_POOL_SIZE=5

# DATABASE_MAX_OVERFLOW: extra connections beyond pool_size under load.
DATABASE_MAX_OVERFLOW=10

# ===== Embedding (Phase 3.5.1: OpenAI-compatible embeddings) =====
# DeepSeek 官方 API 不提供 Embedding 端点，因此 Embedding 走通用
# OpenAI 兼容协议（POST {base_url}/embeddings），可对接以下任一服务：
#   OpenAI:      https://api.openai.com/v1        (text-embedding-3-small: 1536 维)
#   硅基流动:     https://api.siliconflow.cn/v1     (BAAI/bge-* 系列)
#   Qwen:        https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:      http://localhost:11434/v1
#
# EMBEDDING_PROVIDER: human-readable identifier (logging/display only).
EMBEDDING_PROVIDER=

# EMBEDDING_MODEL: model name sent in the request body. Set explicitly — do not guess.
EMBEDDING_MODEL=

# EMBEDDING_BASE_URL: embeddings endpoint base (must serve POST /embeddings).
EMBEDDING_BASE_URL=

# EMBEDDING_API_KEY: leave empty to fall back to LLM_API_KEY (when both APIs share one key).
# NEVER commit real keys to Git.
EMBEDDING_API_KEY=

# EMBEDDING_DIMENSION: expected vector length. Must match knowledge_chunk.embedding vector(N).
# Default 1024 = BAAI/bge-m3 (SiliconFlow, verified in Phase 3.5.1.5). Client validates strictly (no padding/truncation).
EMBEDDING_DIMENSION=1024

# EMBEDDING_TIMEOUT: request timeout in seconds.
EMBEDDING_TIMEOUT=60

# ===== Reranker (Phase 3.5.12: OFFLINE EXPERIMENT ONLY — not wired into RAG) =====
# RERANKER_ENABLED: master switch, default false. When true, the offline
# reranker experiment tests (RUN_REAL_RERANKER=1) may load the local model.
# Production RAG (RagService/ChatService/API) NEVER reads this section.
RERANKER_ENABLED=false

# RERANKER_MODEL: HuggingFace model name (local Cross-Encoder).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# RERANKER_DEVICE: inference device. Empty = auto (cuda if available, else cpu).
# Explicit values allowed: cuda / cpu. NEVER changes any production config.
RERANKER_DEVICE=

# RERANKER_MAX_LENGTH: tokenizer max_length for (query, doc) pairs.
RERANKER_MAX_LENGTH=512