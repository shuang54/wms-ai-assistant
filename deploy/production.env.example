# ============================================================================
# 生产环境变量**模板**（Phase 8 Step 1）
#
#   · 所有 <UPPERCASE_PLACEHOLDER> 必须由部署层注入真实值；
#   · 本文件**不含**任何真实凭据、连接串、密钥或生产地址；
#   · 真实值应通过部署平台的 secret 注入（Vault / KMS / 平台 Secret），
#     **不要**提交到仓库（根 .gitignore 已忽略 .env / .env.* / TLS 材料）；
#   · 不得把测试库地址或测试凭据复制到这里。
# ============================================================================

# ---- 应用层 ----
APP_NAME=wms-ai-assistant
APP_ENV=production
# 必须只监听回环：公网入口只有 Nginx（见 deploy/nginx/）。
# 注意：代码默认值是 0.0.0.0，生产**必须**显式覆盖。
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 数据库（仅后端进程可读；浏览器永不直连）----
DATABASE_URL=<PRODUCTION_DATABASE_URL>
DATABASE_ECHO=0
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- 会话 Cookie ----
# 生产必须为 true：只经 HTTPS 传输会话 Cookie。
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_HOURS=12

# ---- 服务间只读面（X-API-Key；服务端进程读取，**不得**进入浏览器）----
WORKFLOW_READ_API_KEY=<PRODUCTION_WORKFLOW_READ_API_KEY>
WORKFLOW_READ_API_PROJECT_ID=<PRODUCTION_PROJECT_ID>

# ---- 服务间命令面（启动 Run；仅运维侧调用，**不得**进入浏览器）----
WORKFLOW_COMMAND_API_KEY=<PRODUCTION_WORKFLOW_COMMAND_API_KEY>
WORKFLOW_COMMAND_API_PROJECT_ID=<PRODUCTION_PROJECT_ID>

# ---- LLM / 业务库（按实际部署注入；此处只留占位）----
LLM_API_KEY=<PRODUCTION_LLM_API_KEY>
WMS_DATABASE_HOST=<WMS_BUSINESS_DB_HOST>
WMS_DATABASE_PORT=5432
WMS_DATABASE_NAME=<WMS_BUSINESS_DB_NAME>
WMS_DATABASE_USER=<WMS_BUSINESS_DB_USER>
WMS_DATABASE_PASSWORD=<WMS_BUSINESS_DB_PASSWORD>
